import pandas as pd
import matplotlib.pyplot as plt

# Load data from CSV file
csv_file = 'CSV_files/motor2.csv'
raw_df = pd.read_csv(csv_file)

# Extract columns
V_bus_columns = raw_df.iloc[:, 1::5].columns
V_shunt_columns = raw_df.iloc[:, 2::5].columns
current_columns = raw_df.iloc[:, 3::5].columns

# Create an empty DataFrame with columns
mean_df = pd.DataFrame(columns=['V_bus', 'V_shunt', 'current'])

# Check the type of mean_df before the loop
print("Type of mean_df before loop:", type(mean_df))

for i in range(len(V_bus_columns)):
    # Calculate mean for each column
    mean_V_bus = raw_df[V_bus_columns[i]].mean()
    mean_V_shunt = raw_df[V_shunt_columns[i]].mean()
    mean_current = raw_df[current_columns[i]].mean()

    # Append the mean values as a new row using loc
    mean_df.loc[len(mean_df)] = [mean_V_bus, mean_V_shunt, mean_current]


# Plot each column
plt.figure(figsize=(10, 6))

plt.plot(mean_df.index, mean_df['current'], label='V_bus')

plt.xlabel('Index')
plt.ylabel('Value')
plt.title('Mean values of V_bus')
plt.legend()
plt.grid(True)
plt.show()
