import serial
import time

arduino_port = 'COM3'
baud_rate = 9600

ser = serial.Serial(arduino_port, baud_rate)

def read_data():
    while True:
        line = ser.readline().decode('utf-8').strip()
        if line:
            data = line.split(',')
            if len(data) == 3:
                bus_voltage = data[0]
                shunt_voltage = data[1]
                current_mA = data[2]

                print("Bus Voltage:", bus_voltage, "V")
                print("Shunt Voltage:", shunt_voltage, "mV")
                print("Current:", current_mA, "mA")
            #else:
                #print("Received data is not in the expected format:", line)
        time.sleep(0.1)

if __name__ == "__main__":
    try:
        read_data()
    except KeyboardInterrupt:
        print("Exiting...")
    finally:
        ser.close()
